# Server
PORT=5000
NODE_ENV=development
COOKIE_SECURE=false
FRONTEND_URL=http://localhost:5173

# Security: encrypts saved SAP passwords. Never change it after users save passwords.
ENCRYPTION_KEY=

# SAP
USE_MOCK_SAP=false
SAP_AUTH_METHOD=basic
SKIP_GATEWAY_AUTH=false

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=